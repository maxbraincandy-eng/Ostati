# --- Database ---
# Development (default): SQLite
DATABASE_URL="file:./dev.db"
# Production: PostgreSQL (also switch provider in prisma/schema.prisma to "postgresql")
# DATABASE_URL="postgresql://ostati:ostati@localhost:5432/ostati"

# --- Auth ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# Google OAuth (optional — Google login button appears when set)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- AI Assistant (optional — falls back to built-in analyzer when unset) ---
ANTHROPIC_API_KEY=""
