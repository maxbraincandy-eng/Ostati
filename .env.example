# --- Database (PostgreSQL) ---
# Local dev: docker compose up -d
DATABASE_URL="postgresql://ostati:ostati@localhost:5432/ostati"
# Railway/production: use the DATABASE_URL provided by your Postgres service

# --- Auth ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# Google OAuth (optional — Google login button appears when set)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- AI Assistant (optional — falls back to built-in analyzer when unset) ---
ANTHROPIC_API_KEY=""

# --- Payments: Bank of Georgia e-commerce (optional) ---
# Get merchant credentials at https://api.bog.ge (BOG business account).
# When unset, premium checkout runs in demo mode (no real charge).
BOG_CLIENT_ID=""
BOG_CLIENT_SECRET=""
